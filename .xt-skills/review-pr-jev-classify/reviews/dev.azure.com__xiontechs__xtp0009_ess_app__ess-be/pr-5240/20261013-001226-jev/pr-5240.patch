+namespace Ess_App.Application.DTOs.LeaveRequests;
+
+/// <summary>Query for the manager team leave calendar (approved leave of direct reports).</summary>
+public sealed record TeamLeaveCalendarQuery
+{
+    public string ManagerPersonnelNumber { get; init; } = string.Empty;
+    public DateOnly From { get; init; }
+    /// <summary>Inclusive last day of the range.</summary>
+    public DateOnly To { get; init; }
+    public string? LeaveTypeCode { get; init; }
+    public int Page { get; init; } = 1;
+    public int PerPage { get; init; } = 20;
+}
+
+/// <summary>One approved leave day of a direct report.</summary>
+public sealed record TeamLeaveEntryDto
+{
+    public string PersonnelNumber { get; init; } = string.Empty;
+    public string WorkerName { get; init; } = string.Empty;
+    public string RequestId { get; init; } = string.Empty;
+    public string LeaveType { get; init; } = string.Empty;
+    public DateOnly LeaveDate { get; init; }
+    public decimal Amount { get; init; }
+}
