diff --git a/src/Ess-App.Application/Services/LeaveRequests/TeamLeaveCalendarService.cs b/src/Ess-App.Application/Services/LeaveRequests/TeamLeaveCalendarService.cs
new file mode 100644
index 00000000..48db2215
--- /dev/null
+++ b/src/Ess-App.Application/Services/LeaveRequests/TeamLeaveCalendarService.cs
@@ -0,0 +1,131 @@
+using System.Globalization;
+using Ess_App.Application.Constants;
+using Ess_App.Application.DTOs;
+using Ess_App.Application.DTOs.LeaveRequests;
+using Ess_App.Application.Helpers;
+using Ess_App.Application.Interfaces;
+using Ess_App.Application.Interfaces.LeaveRequests;
+using FluentValidation;
+using Microsoft.Extensions.Logging;
+
+namespace Ess_App.Application.Services.LeaveRequests;
+
+/// <summary>
+/// Manager view: approved leave days of the manager's direct reports within a date range.
+/// </summary>
+public class TeamLeaveCalendarService : ITeamLeaveCalendarService
+{
+    private const string LeaveSelect = "PersonnelNumber,RequestId,Type,StartDate,Amount";
+
+    private readonly ID365Service _d365Service;
+    private readonly ICacheService _cacheService;
+    private readonly IValidator<TeamLeaveCalendarQuery> _validator;
+    private readonly ILogger<TeamLeaveCalendarService> _logger;
+
+    public TeamLeaveCalendarService(
+        ID365Service d365Service,
+        ICacheService cacheService,
+        IValidator<TeamLeaveCalendarQuery> validator,
+        ILogger<TeamLeaveCalendarService> logger)
+    {
+        _d365Service = d365Service;
+        _cacheService = cacheService;
+        _validator = validator;
+        _logger = logger;
+    }
+
+    public async Task<PaginatedResponse<TeamLeaveEntryDto>> GetTeamLeaveCalendarAsync(
+        TeamLeaveCalendarQuery query,
+        CancellationToken cancellationToken = default)
+    {
+        await _validator.ValidateAndThrowAsync(query, cancellationToken);
+
+        var cacheKey = CacheKeys.GetTeamLeaveCalendarCacheKey(
+            query.ManagerPersonnelNumber, query.From, query.To, query.Page, query.PerPage);
+        if (_cacheService.TryGet<PaginatedResponse<TeamLeaveEntryDto>>(cacheKey, out var cached) && cached != null)
+        {
+            return cached;
+        }
+
+        var manager = ODataFilterHelper.EscapeString(query.ManagerPersonnelNumber);
+        var reports = (await _d365Service.QueryRecordsAsync(
+            D365EntityNames.Workers,
+            filter: $"ManagerPersonnelNumber eq '{manager}'")).ToList();
+
+        _logger.LogInformation(
+            "Team leave calendar for manager {Manager}: {Count} direct reports",
+            query.ManagerPersonnelNumber, reports.Count);
+
+        var from = query.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+        var to = query.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+        var entries = new List<TeamLeaveEntryDto>();
+        foreach (var report in reports)
+        {
+            var personnelNumber = GetString(report, "PersonnelNumber");
+            var workerName = GetString(report, "Name");
+
+            var filter = $"PersonnelNumber eq '{ODataFilterHelper.EscapeString(personnelNumber)}'"
+                + $" and StartDate ge {from}T00:00:00Z and StartDate lt {to}T00:00:00Z";
+            if (!string.IsNullOrWhiteSpace(query.LeaveTypeCode))
+            {
+                filter += $" and Type eq '{ODataFilterHelper.EscapeString(query.LeaveTypeCode)}'";
+            }
+
+            try
+            {
+                var rows = await _d365Service.QueryRecordsAsync(
+                    D365EntityNames.LeaveApprovedRequests,
+                    filter: filter,
+                    select: LeaveSelect);
+
+                entries.AddRange(rows.Select(r => new TeamLeaveEntryDto
+                {
+                    PersonnelNumber = personnelNumber,
+                    WorkerName = workerName,
+                    RequestId = GetString(r, "RequestId"),
+                    LeaveType = GetString(r, "Type"),
+                    LeaveDate = DateOnly.FromDateTime(DateTime.Parse(GetString(r, "StartDate"), CultureInfo.InvariantCulture)),
+                    Amount = decimal.TryParse(GetString(r, "Amount"), NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) ? amount : 0m
+                }));
+            }
+            catch (Exception ex)
+            {
+                _logger.LogWarning(ex, "Skipping leave of {PersonnelNumber}", personnelNumber);
+            }
+        }
+
+        var pageItems = entries
+            .Skip((query.Page - 1) * query.PerPage)
+            .Take(query.PerPage)
+            .OrderBy(e => e.LeaveDate)
+            .ThenBy(e => e.WorkerName)
+            .ToList();
+
+        var response = new PaginatedResponse<TeamLeaveEntryDto>
+        {
+            Success = true,
+            Message = "Team leave calendar retrieved successfully",
+            Data = pageItems,
+            Pagination = new PaginationMetadata
+            {
+                Page = query.Page,
+                PerPage = query.PerPage,
+                HasNextPage = entries.Count > query.Page * query.PerPage,
+                HasPreviousPage = query.Page > 1
+            }
+        };
+
+        _cacheService.Set(cacheKey, response, new CacheEntryOptions
+        {
+            AbsoluteExpirationRelativeToNow = TimeSpan.FromSeconds(60)
+        });
+
+        return response;
+    }
+
+    private static string GetString(D365RecordDto record, string field)
+        => record.Properties != null && record.Properties.TryGetValue(field, out var value)
+            ? value?.ToString() ?? string.Empty
+            : string.Empty;
+}
