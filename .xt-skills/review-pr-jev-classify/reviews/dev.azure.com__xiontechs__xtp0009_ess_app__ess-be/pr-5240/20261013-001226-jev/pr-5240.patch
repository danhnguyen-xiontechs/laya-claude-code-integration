+namespace Ess_App.Tests.Services.LeaveRequests;
+
+using Ess_App.Application.Constants;
+using Ess_App.Application.DTOs;
+using Ess_App.Application.DTOs.LeaveRequests;
+using Ess_App.Application.Interfaces;
+using Ess_App.Application.Services.LeaveRequests;
+using Ess_App.Application.Validators.LeaveRequests;
+using Ess_App.Tests.Helpers;
+using FluentAssertions;
+using Microsoft.Extensions.Logging;
+using NSubstitute;
+
+public class TeamLeaveCalendarServiceTests
+{
+    private readonly ID365Service _d365Service = Substitute.For<ID365Service>();
+    private readonly InMemoryCacheService _cacheService = new();
+    private readonly TeamLeaveCalendarService _sut;
+
+    public TeamLeaveCalendarServiceTests()
+    {
+        _sut = new TeamLeaveCalendarService(
+            _d365Service,
+            _cacheService,
+            new TeamLeaveCalendarQueryValidator(),
+            Substitute.For<ILogger<TeamLeaveCalendarService>>());
+    }
+
+    [Fact]
+    public async Task GetTeamLeaveCalendarAsync_ReturnsLeaveOfDirectReports_OrderedByDate()
+    {
+        _d365Service.QueryRecordsAsync(D365EntityNames.Workers, Arg.Any<string?>(), Arg.Any<int?>(), Arg.Any<int?>(), Arg.Any<string?>(), Arg.Any<string?>(), Arg.Any<string?>())
+            .Returns(new[] { Record(("PersonnelNumber", "100"), ("Name", "An")) });
+        _d365Service.QueryRecordsAsync(D365EntityNames.LeaveApprovedRequests, Arg.Any<string?>(), Arg.Any<int?>(), Arg.Any<int?>(), Arg.Any<string?>(), Arg.Any<string?>(), Arg.Any<string?>())
+            .Returns(new[]
+            {
+                Record(("RequestId", "R2"), ("Type", "AL"), ("StartDate", "2026-10-05T00:00:00Z"), ("Amount", "1")),
+                Record(("RequestId", "R1"), ("Type", "AL"), ("StartDate", "2026-10-02T00:00:00Z"), ("Amount", "0.5")),
+            });
+
+        var result = await _sut.GetTeamLeaveCalendarAsync(new TeamLeaveCalendarQuery
+        {
+            ManagerPersonnelNumber = "900",
+            From = new DateOnly(2026, 10, 1),
+            To = new DateOnly(2026, 10, 31),
+        });
+
+        result.Data.Select(e => e.RequestId).Should().Equal("R1", "R2");
+        result.Data.First().Amount.Should().Be(0.5m);
+        result.Pagination.HasNextPage.Should().BeFalse();
+    }
+
+    private static D365RecordDto Record(params (string Key, object Value)[] fields)
+        => new() { Properties = fields.ToDictionary(f => f.Key, f => f.Value) };
+}
