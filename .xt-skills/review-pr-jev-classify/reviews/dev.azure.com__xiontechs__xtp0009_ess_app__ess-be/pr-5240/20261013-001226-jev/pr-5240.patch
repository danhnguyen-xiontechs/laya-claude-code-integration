+using Ess_App.Application.DTOs.LeaveRequests;
+using FluentValidation;
+
+namespace Ess_App.Application.Validators.LeaveRequests;
+
+public sealed class TeamLeaveCalendarQueryValidator : AbstractValidator<TeamLeaveCalendarQuery>
+{
+    public const int MaxRangeDays = 31;
+
+    public TeamLeaveCalendarQueryValidator()
+    {
+        RuleFor(x => x.ManagerPersonnelNumber)
+            .NotEmpty().WithMessage("ManagerPersonnelNumber is required.")
+            .MaximumLength(20);
+
+        RuleFor(x => x.To)
+            .GreaterThanOrEqualTo(x => x.From).WithMessage("To must be on or after From.");
+
+        RuleFor(x => x)
+            .Must(x => x.To.DayNumber - x.From.DayNumber < MaxRangeDays)
+            .WithMessage($"The date range must not exceed {MaxRangeDays} days.");
+
+        RuleFor(x => x.LeaveTypeCode)
+            .MaximumLength(20);
+
+        RuleFor(x => x.Page).GreaterThanOrEqualTo(1);
+        RuleFor(x => x.PerPage).InclusiveBetween(1, 100);
+    }
+}
