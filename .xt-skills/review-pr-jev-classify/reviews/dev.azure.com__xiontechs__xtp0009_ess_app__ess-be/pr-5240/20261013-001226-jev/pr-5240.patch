+using Ess_App.Application.DTOs;
+using Ess_App.Application.DTOs.LeaveRequests;
+using Ess_App.Application.Interfaces.LeaveRequests;
+using FluentValidation;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Ess_App.API.Controllers.LeaveRequests;
+
+[Route("api/leave/team-calendar")]
+[ApiController]
+[Authorize]
+public class TeamLeaveCalendarController : ControllerBase
+{
+    private readonly ITeamLeaveCalendarService _teamLeaveCalendarService;
+
+    public TeamLeaveCalendarController(ITeamLeaveCalendarService teamLeaveCalendarService)
+    {
+        _teamLeaveCalendarService = teamLeaveCalendarService;
+    }
+
+    /// <summary>
+    /// Returns approved leave days of a manager's direct reports in a date range (max 31 days).
+    /// </summary>
+    [HttpGet]
+    [ProducesResponseType(typeof(PaginatedResponse<TeamLeaveEntryDto>), StatusCodes.Status200OK)]
+    [ProducesResponseType(StatusCodes.Status400BadRequest)]
+    public async Task<ActionResult<PaginatedResponse<TeamLeaveEntryDto>>> GetTeamLeaveCalendar(
+        [FromQuery] TeamLeaveCalendarQuery query,
+        CancellationToken cancellationToken)
+    {
+        try
+        {
+            var result = await _teamLeaveCalendarService.GetTeamLeaveCalendarAsync(query, cancellationToken);
+            return Ok(result);
+        }
+        catch (ValidationException ex)
+        {
+            return BadRequest(ex.Message);
+        }
+    }
+}
