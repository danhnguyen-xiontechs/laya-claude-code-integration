{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "haiku-build run manifest",
  "type": "object",
  "required": ["schemaVersion", "runId", "tool", "status", "task", "opusCalls", "phases", "haiku"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string" },
    "tool": { "const": "haiku-build" },
    "status": {
      "enum": ["INTAKE", "PLANNED", "BUILT", "TESTS_PASS", "TESTS_FAIL", "REVIEWED", "PLAN_FAILED", "REVIEW_SKIPPED", "FIXED", "REPORTED", "INCOMPLETE"]
    },
    "task": { "type": "string" },
    "finalStatus": {
      "description": "v2 final status, written only by scripts/status.mjs final; never takes JEV input",
      "enum": ["done", "done_with_findings", "blocked"]
    },
    "finalReason": { "type": ["string", "null"], "description": "why: the missing artifact, the used-up ladder, failing tests or the open-finding count" },
    "routing": {
      "type": "object",
      "description": "written by scripts/routing.mjs --write; every stage has a model",
      "required": ["main", "stages"],
      "properties": {
        "start": { "enum": ["haiku", "sonnet", "opus", "fable", null] },
        "main": { "enum": ["haiku", "sonnet", "opus", "fable"] },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "model"],
            "properties": {
              "id": { "enum": ["01-intake", "02-plan", "03-implement", "04-test", "05-review", "06-fix", "07-present"] },
              "model": { "enum": ["haiku", "sonnet", "opus", "fable"] },
              "fallback": {
                "description": "the one extra model call the stage may make: 03-implement one Sonnet fallback, 06-fix at most one Sonnet re-review; null elsewhere",
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["model", "role", "max"],
                    "properties": {
                      "model": { "const": "sonnet" },
                      "role": { "enum": ["implement", "re-review"] },
                      "max": { "const": 1 }
                    }
                  }
                ]
              }
            }
          }
        },
        "switchQuestion": { "type": ["string", "null"], "description": "only for an Opus or Fable start: \"switch main session to Sonnet?\"" },
        "switchAnswer": { "type": ["string", "null"], "description": "the user's one answer; kept once stored" }
      }
    },
    "attempts": {
      "type": "array",
      "description": "test runs on the retry ladder T1, T2, sonnet-retry, T3, recorded by scripts/status.mjs record",
      "items": {
        "type": "object",
        "required": ["attempt", "model", "ok"],
        "properties": {
          "attempt": { "enum": ["T1", "T2", "sonnet-retry", "T3"] },
          "model": { "enum": ["haiku", "sonnet"] },
          "ok": { "type": "boolean" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "jev": {
      "type": "object",
      "description": "optional JEV advice, written by scripts/jev_advice.mjs; advisory only, never a status",
      "properties": {
        "mode": { "enum": ["apply", "off"] },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["point", "choice", "source", "called", "reason"],
            "properties": {
              "point": { "enum": ["intake", "recovery", "triage"] },
              "choice": { "type": "string" },
              "source": { "enum": ["jev", "baseline"] },
              "called": { "type": "boolean" },
              "reason": { "type": "string" },
              "confidence": { "type": ["number", "null"] },
              "at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "decision": { "enum": ["fix_and_report", "not_approved_report", "re_verify_only", null], "description": "set by the main session in stage 05 from the triage (fix_and_report or re_verify_only), or not_approved_report when the review was skipped or the plan failed; never a user question" },
    "planAnswers": {
      "type": "array",
      "description": "answers to the spec's blocking questions (section 3); authoritative for Implement, Review and the report",
      "items": {
        "type": "object",
        "required": ["question", "answer", "section"],
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "section": { "type": "string", "description": "spec section number the answer changes, e.g. \"6\"" }
        }
      }
    },
    "planFailed": { "type": "boolean" },
    "planFailure": { "type": ["string", "null"] },
    "transcript": { "type": ["string", "null"], "description": "main session .jsonl; subagents read from <session>/subagents/" },
    "opusCalls": {
      "type": "array",
      "description": "every Opus call (the plan, stage 02-plan), retries included, plus the review save record that scripts/save_opus.mjs review (build_report.mjs saveReview) writes for stage 05-review; the review itself runs on Sonnet",
      "items": {
        "type": "object",
        "required": ["step", "attempt", "words", "ok"],
        "properties": {
          "step": { "enum": ["02-plan", "04-review"], "description": "02-plan: the Opus plan call. 04-review: the review save record written by saveReview (historical v1 name), not an Opus call" },
          "attempt": { "type": "integer", "minimum": 1 },
          "words": { "type": ["integer", "null"] },
          "ok": { "type": "boolean" },
          "sha256": { "type": ["string", "null"], "description": "hash of the saved spec text (plan) or review JSON; null when the call failed" },
          "reason": { "type": ["string", "null"], "description": "why the output failed the check; null when ok" },
          "retryApprovedBy": { "type": ["string", "null"] },
          "retryAt": { "type": ["string", "null"] }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "from", "to"],
        "properties": {
          "phase": { "enum": ["01-intake", "02-plan", "03-implement", "04-test", "05-review", "06-fix", "07-present"], "description": "the seven v2 stages, opened by scripts/phase.mjs" },
          "from": { "type": "string", "format": "date-time" },
          "to": { "type": "string", "format": "date-time" },
          "model": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "description": "v3: one entry per failed test attempt (status.mjs record fail, auto.mjs) and per failed plan or review hand-back (save_opus.mjs) (additive, optional)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt", "kind", "fingerprint", "category", "failed", "progress", "repeated", "summary", "at"],
        "properties": {
          "attempt": { "type": ["string", "integer", "null"], "description": "ladder rung (T1, T2, ...) for a test, hand-back attempt number for plan or review" },
          "kind": { "type": "string" },
          "fingerprint": { "type": ["string", "null"], "description": "sha256 of the normalised log; null when the log is empty or missing" },
          "category": { "enum": ["test-failure", "assertion", "syntax", "missing-module", "timeout", "review-invalid", "plan-invalid", "unknown"] },
          "failed": { "type": ["integer", "null"] },
          "progress": { "enum": ["first", "same", "improved", "worse", "changed"] },
          "repeated": { "type": "boolean" },
          "summary": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "acMap": {
      "description": "v3: AC traceability from v3.mjs parseAcMap; null when the spec is not known (additive, optional)",
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "text", "target", "test", "command", "missing"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "target": { "type": ["string", "null"] },
          "test": { "type": ["string", "null"] },
          "command": { "type": ["string", "null"] },
          "missing": { "type": "array", "items": { "enum": ["target", "test", "command"] } }
        }
      }
    },
    "metrics": {
      "description": "v3: run metrics from v3.mjs runMetrics; a missing measurement is null (additive, optional)",
      "type": "object",
      "properties": {
        "stages": { "type": "array", "items": { "type": "object", "required": ["phase", "ms"], "properties": { "phase": { "type": "string" }, "ms": { "type": ["integer", "null"] } } } },
        "attempts": { "type": "object", "properties": { "total": { "type": "integer" }, "failed": { "type": "integer" }, "byModel": { "type": "object" } } },
        "tests": { "type": ["object", "null"], "properties": { "passed": { "type": ["integer", "null"] }, "failed": { "type": ["integer", "null"] } } },
        "repeats": { "type": "integer" }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": { "enum": ["done", "skipped", "not_run"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "lens", "finding", "ref", "resolution"],
            "properties": {
              "severity": { "enum": ["Major", "Minor"] },
              "lens": { "enum": ["blind-hunter", "edge-case-hunter", "verification-gap"] },
              "finding": { "type": "string" },
              "ref": { "type": "string" },
              "resolution": { "enum": ["open", "fixed", "rejected"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "haiku": {
      "type": "object",
      "description": "computed by build_report.mjs from the transcript, never typed by hand",
      "required": ["haiku_request_count", "haiku_requests_over_100k", "max_haiku_input_tokens", "input_limit_verification"],
      "properties": {
        "haiku_request_count": { "type": ["integer", "null"] },
        "haiku_requests_over_100k": { "type": ["integer", "null"] },
        "max_haiku_input_tokens": { "type": ["integer", "null"] },
        "input_limit_verification": { "enum": ["pass", "fail", "not_measured"] },
        "reason": {
          "description": "why the verdict is not_measured or fail context: no_transcript, open_window, overlap, no_windows, no_haiku_usage; null when pass or fail",
          "enum": ["no_transcript", "open_window", "overlap", "no_windows", "no_haiku_usage", null]
        }
      }
    }
  }
}
