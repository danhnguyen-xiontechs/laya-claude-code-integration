+
+
+HELPER_CALL = re.compile(r"(?<![\w.])((?:assert|check|expect|verify)_\w+)\s*\(")
+ASSERT_CHARS = 160
+
+
+def _bare(nodeid: str) -> str:
+    return nodeid.split("::")[-1].split("[")[0]
+
+
+def _cut(s: str, n: int = ASSERT_CHARS) -> str:
+    s = " ".join(s.split())
+    return s if len(s) <= n else s[: n - 1] + "…"
+
+
+def digest(pack: dict, results: dict | None, *, max_asserts: int = 4, show_skippable: bool = False) -> str:
+    """Reading list for Claude: per criterion, its candidate tests with their assertion lines and helper calls.
+    Skippable pairs are hidden (listed by name) unless show_skippable. Never prints a coverage word."""
+    pairs = {(p["criterion"], p["tid"]): p for p in (results or {}).get("pairs") or []}
+    tests = pack["tests"]
+    if results is None:
+        jev = "JEV not run"
+    else:
+        status = results.get("status") or "not run"
+        if results.get("error"):
+            status += f" ({results['error']})"
+        all_pairs = results.get("pairs") or []
+        labelled = sum(p["label"] is not None for p in all_pairs)
+        jev = f"JEV {status}: {labelled}/{len(all_pairs)} labelled, {results.get('skippableCount', 0)} skippable {'shown' if show_skippable else 'hidden'}"
+    lines = [
+        f"{pack.get('testsDiscovered')} tests under {pack.get('testsDir')}; top {pack.get('topK')} candidates per criterion; {jev}",
+        "Open every test listed below before deciding. Labels are suggestions, never coverage.",
+    ]
+    shown_under: dict[str, str] = {}
+    for c in pack["criteria"]:
+        lines += ["", f"{c['id']}: {c['text']}"]
+        if c.get("no_candidates"):
+            lines.append("  no test shares a meaningful word with this criterion: grep for other names before concluding there is no test")
+            continue
+        visible, hidden = [], []
+        for cand in c["candidates"]:
+            p = pairs.get((c["id"], cand["tid"]), {})
+            (hidden if p.get("skippable") and not show_skippable else visible).append((cand, p))
+        if hidden and not visible:
+            names = ", ".join(_bare(tests[cand["tid"]]["nodeid"]) for cand, _ in hidden)
+            lines.append(f"  all {len(hidden)} candidates hidden as skippable: {names}; grep for other names before concluding there is no test")
+            continue
+        for cand, p in visible:
+            t = tests[cand["tid"]]
+            if results is None:
+                jev_part = "jev=not run"
+            elif p.get("label") is None:
+                jev_part = f"jev=none ({p.get('reason') or 'no label'})"
+            else:
+                jev_part = f"jev={SHORT[p['label']]}" + (f" p={p['p']:.2f}" if p.get("p") is not None else "")
+            extra = (f" exec={t['execution']}" if t.get("execution") not in (None, "Unknown") else "") + (" code truncated" if t.get("truncated") else "")
+            lines.append(f"  {cand['tid']} {t['nodeid']} ({t['file']}:{t['line']}) {jev_part}{extra}")
+            if cand["tid"] in shown_under:
+                lines.append(f"      (assertions shown under {shown_under[cand['tid']]})")
+                continue
+            shown_under[cand["tid"]] = c["id"]
+            asserts = t.get("assertions") or []
+            for a in asserts[:max_asserts]:
+                lines.append(f"      {_cut(a)}")
+            if len(asserts) > max_asserts:
+                lines.append(f"      (+{len(asserts) - max_asserts} more assertions)")
+            if not asserts:
+                lines.append("      (no assert statements in the test body)")
+            helpers = sorted(set(HELPER_CALL.findall(t.get("code") or "")))
+            if helpers:
+                lines.append(f"      helpers: {', '.join(helpers)} (their assertions are not shown: open them)")
+        if hidden:
+            lines.append("  hidden as skippable: " + ", ".join(_bare(tests[cand["tid"]]["nodeid"]) for cand, _ in hidden))
+    return "\n".join(lines)
