+def _status_line(cur: dict, log_rel: str) -> str:
+    status = "PASS" if cur["exitCode"] == 0 else "FAIL"
+    return (f"[curator] UNDERLYING COMMAND STATUS: {status} (exit {cur['exitCode']}) · "
+            f"{len(cur['omittedLines'])} of {cur['totalLines']} lines omitted · full log: {log_rel}")
