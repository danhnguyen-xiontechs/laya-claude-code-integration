+def rank(cur: dict) -> list[dict]:
+    """Kept items in pointer order, so that JEV's scores reach the printed list:
+    (a) parser failure anchors, line order, at most ANCHOR_SLOTS;
+    (b) chunks JEV scored above omitMaxP, by p descending (a regex-pinned chunk with such a p counts here);
+    (c) failure anchors beyond ANCHOR_SLOTS, then the other always-keep (regex-pinned) chunks, line order;
+    (d) kept chunks JEV never answered, line order.
+    Ties keep line order; omitted chunks are never listed."""
+    cut = cur.get("omitMaxP", DEFAULTS["omitMaxP"])
+    anchors = sorted(({**a, "label": "anchor"} for a in cur.get("anchors", [])), key=lambda b: b["start"])
